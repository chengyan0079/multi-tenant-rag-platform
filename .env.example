# RAG-Ultra 环境变量示例
# 复制为 .env 后按实际环境修改；.env 已被 .gitignore 忽略，不入库。
# pydantic-settings 会自动加载本文件（common/config.py），变量名与 Config 字段一致。

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000

# OpenAPI 文档开关（/docs、/redoc、/openapi.json）；默认关，开发环境设为 True 开启
OPENAPI_ENABLED=False

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fqa_rag

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Milvus ----
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=rag_ultra
MILVUS_COLLECTION=rag_chunks

# ---- 对象存储（MinIO） ----
MINIO_ENABLED=True
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=rag-ultra
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=

# ---- 服务发现（nacos） ----
NACOS_ENABLED=True
NACOS_SERVER_ADDR=http://localhost:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ---- 配置中心（nacos，独立命名空间） ----
NACOS_CONFIG_ENABLED=True
NACOS_CONFIG_SERVER_ADDR=http://localhost:8848
NACOS_CONFIG_NAMESPACE=rag-ultra
NACOS_CONFIG_GROUP=SYSTEM

# ---- 模型（LLM 网关，OpenAI 兼容） ----
LLM_MODEL_NAME=deepseek-flash
LLM_MODEL_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
