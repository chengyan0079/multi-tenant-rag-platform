# RAG-Ultra 环境变量示例
# 复制为 .env 后按实际环境修改；.env 已被 .gitignore 忽略，不入库。
# pydantic-settings 会自动加载本文件（common/config.py），变量名与 Config 字段一致。

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
WORKERS=1

# OpenAPI 文档开关（/docs、/redoc、/openapi.json）；默认关，开发环境设为 True 开启
OPENAPI_ENABLED=False

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=rag_ultra

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Milvus ----
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=rag_ultra
MILVUS_COLLECTION=rag_chunks

# ---- 对象存储（MinIO） ----
MINIO_ENABLED=True
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=rag-ultra
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- 服务发现（nacos） ----
NACOS_ENABLED=True
NACOS_SERVER_ADDR=http://localhost:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# ---- 配置中心（nacos，独立命名空间） ----
NACOS_CONFIG_ENABLED=True
NACOS_CONFIG_SERVER_ADDR=http://localhost:8848
NACOS_CONFIG_NAMESPACE=rag-ultra
NACOS_CONFIG_GROUP=SYSTEM

# ---- 故障图谱（Neo4j + 图检索） ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
GRAPH_ENABLED=True
GRAPH_MAX_EVIDENCE=24
GRAPH_QUERY_TIMEOUT=0.8
GRAPH_INGEST_ENABLED=True
GRAPH_SCHEDULE_ENABLED=True
GRAPH_SCHEDULE_INTERVAL_SEC=3600

# ---- 故障要素抽取模型（vLLM OpenAI 兼容） ----
VLLM_BASE_URL=
VLLM_EXTRACT_MODEL=

# ---- 检索与融合 ----
RECALL_K=50
RERANK_TOP_K=8
RRF_K=60
FAQ_BM25_ENABLED=True
FAQ_BM25_THRESHOLD=2.0

# ---- 模型（LLM 网关，OpenAI 兼容） ----
LLM_MODEL_NAME=deepseek-flash
LLM_MODEL_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# ---- 调用方鉴权（HMAC 签名） ----
AUTH_HMAC_ENABLED=True
AUTH_HMAC_SECRET=
AUTH_HMAC_TTL=60
AUTH_HMAC_FAIL_CLOSED=False
IDENTITY_DEFAULT_ENABLED=True
DEFAULT_TENANT_ID=100
DEFAULT_USER_ID=1001
